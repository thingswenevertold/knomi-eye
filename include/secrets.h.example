#pragma once

// Copy this file to secrets.h (gitignored) and fill in your own values.
// secrets.h is included by src/ota.cpp — never commit real credentials.

// Two known networks (e.g. home + workshop). ota::begin() tries the first,
// then falls back to the second if it isn't in range / fails to connect.
// Leave WIFI_SSID_2 empty ("") if you only have one network.
#define WIFI_SSID_1     "your-wifi-name"
#define WIFI_PASSWORD_1 "your-wifi-password"

#define WIFI_SSID_2     "your-second-wifi-name"
#define WIFI_PASSWORD_2 "your-second-wifi-password"

// Password required to push OTA updates to this device.
#define OTA_PASSWORD  "choose-a-dev-only-password"

// Shown in the router / on the network, used as the WiFi hostname AND as the
// mDNS name, so <name>.local reaches the board.
//
// MUST BE UNIQUE PER BOARD. Two boards flashed with the same value both claim
// the name and <name>.local resolves to whichever answers first — silently,
// with no error anywhere. See "Two boards, one hostname" in
// PANDA_KNOMI_FINDINGS.md; it cost a morning of chasing a flash that had
// worked all along.
//
// Prefer this to a static DHCP lease: an mDNS name follows the board onto any
// network, which a reserved IP cannot do.
#define OTA_HOSTNAME  "knomi-eye"

// HTTP Basic Auth for the web admin dashboard (http://<OTA_HOSTNAME>.local/).
// Username is always "admin".
#define ADMIN_PASSWORD "choose-a-dev-only-password"

// Nom annonce en Bluetooth. C'est ce que tu vois dans la liste des
// appareils sur ton telephone.
#define BLE_NAME "Zaza"

// Code d'appairage Bluetooth a 6 chiffres, 0 pour laisser l'acces libre.
// Un chiffre entre 100000 et 999999 force le telephone a demander le code
// et chiffre la liaison. Laisse 0 tant que tu n'as pas teste : un code mal
// saisi te couperait de la seule interface qui marche sans reseau.
#define BLE_PASSKEY 0
