#pragma once

// Copy to secrets.h (gitignored) and fill in. This hub stays on its own
// network (e.g. at work) — it never needs to reach the knomi-eye devices
// directly, only GitHub (raw.githubusercontent.com), so a single WiFi
// network is enough.

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Fine-grained GitHub PAT, "Contents: Read and write" on the knomi-eye repo
// only. Can be the SAME token used for GITHUB_STATUS_TOKEN in knomi-eye's
// secrets.h — same repo, same permission. Needed so scanning a tag here can
// push a command/<device>.json for the matching KNOMI to pick up.
#define GITHUB_WRITE_TOKEN ""
